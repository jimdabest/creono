/tests/_output/
/tests/coverage/
*.test.log
coverage.xml
*.clover

# ==========================================
# 8. PROJECT SPECIFIC
# ==========================================

# Database dumps (trừ file mẫu)
/*.sql
!creono_db.sql
!sample_data.sql
!migration/*.sql

# Session files
/tmp/sessions/
/sessions/
*.sess

