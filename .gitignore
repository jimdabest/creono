# ==========================================
# 1. CẤU HÌNH VÀ MÔI TRƯỜNG
# ==========================================

# Bỏ qua toàn bộ file trong config nhưng giữ lại các file .example
# /config/*
/config/email.php
/.env
/.env.local
/.env.*.local

# File cấu hình IDE
/.vscode/
/.idea/
/.project
/.settings/
/*.iml

# ==========================================
# 2. LOGS VÀ CACHE
# ==========================================

# Log files
# Bỏ qua toàn bộ file trong logs nhưng giữ lại các file .example
/logs/*
!/logs/*.example
*.log
error_log
access_log
/libs
# Cache
/cache/
/cache/*.tmp
/tmp/
/*.tmp
/*.cache

# ==========================================
# 3. THƯ MỤC UPLOAD (File người dùng)
# ==========================================

# Thư mục upload (giữ cấu trúc nhưng bỏ qua files)
/public/uploads/
/public/uploads/avatars/
/public/uploads/products/
/public/uploads/temp/
/public/uploads/*.*
!/public/uploads/index.html
!/public/uploads/.gitkeep

# ==========================================
# 4. DEPENDENCIES VÀ PACKAGES
# ==========================================

# Composer
/vendor/
/composer.lock
/composer.phar

# NPM/Node
/node_modules/
/npm-debug.log
/yarn-error.log
/package-lock.json
/yarn.lock

